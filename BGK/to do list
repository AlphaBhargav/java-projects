
import java.util.Scanner;

public class BGK {

     static String[] bhargav = new String[100];

     static Scanner scanner = new Scanner(System.in);

     static int count = 0;
    public static void main(String[] args) {

        while(true){

      System.out.println("============ BGK TO DO LIST ============\n");
      System.out.println("1.addtask \n 2.deletetask \n 3.viewtask \n 4.completedtask \n 5.exit");
      System.out.print("enter your choice : ");
      int n = scanner.nextInt();

      switch(n)
      {
        case 1:  addtask();
                 break;
        case 2: deletetask();
                 break;
        case 3:  viewtask();
                 break;
        case 4: completedtask();
                 break;
        case 5:  exit();
                 break;
      }

    }
}

    static int addtask()
    {
       System.out.print("enter the task : ");
       bhargav[count] = scanner.next();
       count++;
       return count;
    }

 static int deletetask() {

    viewtask();

    System.out.print("Enter task number to delete: ");
    int b = scanner.nextInt();

    if (b <= 0 || b > count) {
        System.out.println("Invalid task number.");
    }

    for (int i = b - 1; i < count - 1; i++) {
        bhargav[i] = bhargav[i + 1];
    }

    bhargav[count - 1] = null;
    count--;

    System.out.println("Task deleted successfully.");

    return count;
}

   static int viewtask()
   {
      int j;

    System.out.println("Your tasks are : ");

     for(j = 0;j<count;j++)
     {
       System.out.println((j+1) + ". " + bhargav[j]);
     }

     return count;
   }

   static  int completedtask()
   {
      System.out.print("Which task was completed : ");
      int t = scanner.nextInt();
      if(t<=count && t>0)
        {
            System.out.print( "<>" + t + " Task completed successfully");
        }
      return count;
   }

   static int exit()
   {
        System.out.print("Thank you for using BGK TO DO LIST");
        System.exit(0);
        return count;
   }
   
}
